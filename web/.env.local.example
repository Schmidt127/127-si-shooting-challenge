# Copy to web/.env.local for local development. Never commit .env.local.
#
# Local development reads the Production base. Set AIRTABLE_BASE_ID explicitly
# to the production base only for an authorized production-readiness check.
# Vercel production always uses the production base ID.

AIRTABLE_API_TOKEN=
# Production Shooting Challenge base
AIRTABLE_BASE_ID=appn84sqPw03zEbTT

NEXT_PUBLIC_BASE_PATH=/shoot
NEXT_PUBLIC_LANDING_URL=https://www.fairfieldbasketballclub.com
NEXT_PUBLIC_SITE_URL=https://www.fairfieldbasketballclub.com/shoot

# Set to true at build time to allow search indexing on public program pages.
# Defaults to false (noindex) when unset.
# NEXT_PUBLIC_ALLOW_SEARCH_INDEXING=true

# Optional — embed URL for /shoot/game-manual
# NEXT_PUBLIC_GAME_MANUAL_URL=

# Optional — when set, middleware + /api/airtable require this token
# (Bearer header, site_access cookie, or ?site_access_token=)
# SITE_ACCESS_TOKEN=
