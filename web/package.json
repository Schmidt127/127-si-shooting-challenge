{
  "name": "127-si-shooting-challenge-web",
  "version": "0.1.0",
  "private": true,
  "description": "Private development site for the 127 Sports Intensity Shooting Challenge (Softr replacement).",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test tests/production-smoke.spec.ts tests/search-indexing.spec.ts",
    "test:smoke:prod": "PLAYWRIGHT_BASE_URL=https://www.fairfieldbasketballclub.com/shoot/ playwright test tests/production-smoke.spec.ts tests/search-indexing.spec.ts",
    "test:smoke:http": "node scripts/http-smoke.mjs",
    "test:smoke:http:prod": "SMOKE_BASE_URL=https://www.fairfieldbasketballclub.com/shoot SMOKE_REQUIRE_AIRTABLE_CONFIG=true node scripts/http-smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.14.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.21",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.28.0",
    "eslint-config-next": "^16.3.1",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
