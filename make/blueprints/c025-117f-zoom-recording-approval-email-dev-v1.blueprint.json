                                            "value": "<!doctype html>\n<html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><title>Zoom Recording Quiz Approved</title></head>\n<body style=\"margin:0;padding:0;background:#F2F2F2;font-family:Arial,Helvetica,sans-serif;color:#262626;\">\n<div style=\"padding:20px 12px;background:#F2F2F2;\"><div style=\"max-width:640px;margin:0 auto;\">\n<div style=\"background:#fff4e8;border:1px solid #ffd3a1;color:#7a4a00;border-radius:12px;padding:12px 14px;margin:0 0 14px 0;font-size:13px;font-weight:700;\">TEST MODE — not sent to the live parent recipient (intended: {{8.\\Parent Email - Cleaned\\}}).</div>\n<div style=\"background:#0034B7;color:#ffffff;border-radius:16px;padding:18px 20px;margin:0 0 14px 0;\">\n<div style=\"font-size:21px;font-weight:800;margin:0 0 6px 0;\">Zoom Recording Quiz Approved</div>\n<div style=\"font-size:12px;opacity:0.96;\">A recording quiz review is complete for your athlete.</div>\n</div>\n<div style=\"background:#ffffff;border-radius:14px;padding:18px 20px;margin:0 0 14px 0;\">\n<div style=\"font-size:16px;font-weight:700;color:#FF8B00;margin:0 0 10px 0;\">Update</div>\n<p style=\"margin:0;line-height:1.4;\">Hello {{8.\\Parent First Name\\}},</p>\n<p style=\"margin:10px 0 0 0;line-height:1.4;\">The Zoom recording quiz for {{8.\\Full Athlete Name\\}} has been marked <strong>Satisfactory</strong>. Recording attendance credit follows Stage 17 program rules.</p>\n</div>\n<div style=\"background:#ffffff;border-radius:14px;padding:18px 20px;margin:0 0 14px 0;\">\n<div style=\"font-size:16px;font-weight:700;color:#FF8B00;margin:0 0 10px 0;\">Summary</div>\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse;\">\n<tr><td style=\"padding:4px 0;font-weight:700;width:165px;\">Athlete</td><td style=\"padding:4px 0;\">{{8.\\Full Athlete Name\\}}</td></tr>\n<tr><td style=\"padding:4px 0;font-weight:700;\">Meeting</td><td style=\"padding:4px 0;\">{{9.\\Meeting Name\\}}</td></tr>\n<tr><td style=\"padding:4px 0;font-weight:700;\">Meeting Start</td><td style=\"padding:4px 0;\">{{9.\\Start Time\\}}</td></tr>\n<tr><td style=\"padding:4px 0;font-weight:700;\">Timing</td><td style=\"padding:4px 0;\">{{ifempty(1.timing; \"On Satisfactory\")}}</td></tr>\n<tr><td style=\"padding:4px 0;font-weight:700;\">Recording XP</td><td style=\"padding:4px 0;\">{{7.\\Zoom XP Amount\\}}</td></tr>\n</table>\n</div>\n<div style=\"background:#ffffff;border-radius:14px;padding:18px 20px;margin:0 0 14px 0;\">\n<div style=\"font-size:16px;font-weight:700;color:#FF8B00;margin:0 0 10px 0;\">Questions</div>\n<p style=\"margin:0 0 10px 0;\">Please reply if you have any questions about this update or next steps.</p>\n<p style=\"margin:0;\">Thank you,<br>Coach Mike</p>\n</div>\n<div style=\"background:#0034B7;color:#ffffff;border-radius:16px;padding:16px 20px;font-size:12px;\">127 Sports Intensity<br>Youth sports communication and development support</div>\n</div></div>\n</body></html>"
