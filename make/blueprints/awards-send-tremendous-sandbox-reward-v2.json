    {
      "id": 8,
      "module": "http:MakeRequest",
      "version": 4,
      "parameters": {
        "authenticationType": "apiKey",
        "tlsType": ""
      },
      "mapper": {
        "url": "https://testflight.tremendous.com/api/v2/orders",
        "method": "post",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          },
          {
            "name": "Accept",
            "value": "application/json"
          }
        ],
        "contentType": "json",
        "parseResponse": true,
        "stopOnHttpError": true,
        "allowRedirects": true,
        "shareCookies": false,
        "requestCompressedContent": true,
        "inputMethod": "jsonString",
        "jsonStringBodyContent": "{\n  \"external_id\": \"AWARD|{{9.`Award Recipient Unique Key`}}\",\n  \"payment\": {\n    \"funding_source_id\": \"BALANCE\"\n  },\n  \"reward\": {\n    \"campaign_id\": \"HYNKRMGH3QQR\",\n    \"value\": {\n      \"denomination\": {{first(9.`Award Amount`)}},\n      \"currency_code\": \"USD\"\n    },\n    \"delivery\": {\n      \"method\": \"EMAIL\",\n      \"meta\": {\n        \"sender_name\": \"127 Sports Intensity\",\n        \"subject_line\": \"You earned a 127 Sports Intensity award!\",\n        \"message\": \"Congratulations {{first(9.`Athlete Name - Display`)}}!\\n\\nYou earned the {{9.`Award - Display`}} through the 127 Sports Intensity Shooting Challenge.\\n\\nCoach's feedback:\\n\\n{{9.`Coach Feedback - Awards`}}\\n\\nKeep working hard and continue building your game!\\n\\n— Coach Mike\"\n      }\n    },\n    \"recipient\": {\n      \"name\": \"{{first(9.`Athlete Name - Display`)}}\",\n      \"email\": \"{{first(2.`Parent Email`)}}\"\n    }\n  }\n}"
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 150,
          "name": "Send Tremendous Sandbox"
        },
        "c028LiveModuleNote": "In the live Make scenario this HTTP module may appear as Module 14. Recipient must be nested under Reward — never a top-level sibling of Reward.",
        "restore": {
          "parameters": {
            "authenticationType": {
              "label": "API key — Make credential only. Must send Authorization: Bearer TEST_[Sandbox key]. Never commit the key. Do not use No authentication. Do not put the key in a visible header."
            },
            "tlsType": {
              "label": "Empty"
            },
            "apiKeyKeychain": {
              "label": "REPLACE_WITH_MAKE_API_KEY_CREDENTIAL (Sandbox TEST_ Bearer)"
            }
          },
          "expect": {
            "method": {
              "mode": "chose",
              "label": "POST"
            },
            "contentType": {
              "label": "application/json"
            },
            "parseResponse": {
              "mode": "chose"
            },
            "stopOnHttpError": {
              "mode": "chose"
            },
            "inputMethod": {
              "label": "JSON string importable fallback — switch to Data structure in Make UI when available"
            }
          }
        },
        "c028HttpDataStructureGuide": {
          "preferredInputMethod": "dataStructure",
          "why": "Coach Feedback - Awards may contain line breaks, quotes, and apostrophes. Data structure avoids broken JSON.",
          "requiredHierarchy": [
            "Reward",
            "  Campaign ID",
            "  Value",
            "  Delivery",
            "  Recipient",
            "    Name",
            "    Email"
          ],
          "tree": {
            "external_id": "AWARD|{{9.Award Recipient Unique Key}}",
            "payment": {
              "funding_source_id": "BALANCE"
            },
            "reward": {
              "campaign_id": "HYNKRMGH3QQR",
              "value": {
                "denomination": "{{first(9.Award Amount)}}",
                "currency_code": "USD"
              },
              "delivery": {
                "method": "EMAIL",
                "meta": {
                  "sender_name": "127 Sports Intensity",
                  "subject_line": "You earned a 127 Sports Intensity award!",
                  "message": "Congratulations {{first(9.Athlete Name - Display)}}!\n\nYou earned the {{9.Award - Display}} through the 127 Sports Intensity Shooting Challenge.\n\nCoach's feedback:\n\n{{9.Coach Feedback - Awards}}\n\nKeep working hard and continue building your game!\n\n— Coach Mike"
                }
              },
              "recipient": {
                "name": "{{first(9.Athlete Name - Display)}}",
                "email": "{{first(2.Parent Email)}}"
              }
            }
          },
          "notes": [
            "CRITICAL: Recipient is inside Reward. Do not leave Recipient at the top level next to Reward.",
            "Parent receives the email via first(2.Parent Email).",
            "Athlete Name - Display is the reward recipient name and greeting only.",
            "Use singular reward, not rewards[].",
            "Use delivery.method EMAIL, not delivery_method.",
            "Use delivery.meta.sender_name (not from_name).",
            "Do not map the linked Award array; use Award - Display text.",
            "jsonStringBodyContent uses single \\n escapes only (no \\\\n)."
          ]
        }
      },
