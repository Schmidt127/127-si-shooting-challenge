      "mapper": {
        "url": "https://testflight.tremendous.com/api/v2/orders",
        "serializeUrl": false,
        "method": "post",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer "
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "qs": [],
        "bodyType": "raw",
        "contentType": "application/json",
        "input": "{\n  \"external_id\": \"AWARD|{{2.`Award Recipient Unique Key`}}\",\n  \"payment\": {\n    \"funding_source_id\": \"BALANCE\"\n  },\n  \"reward\": {\n    \"campaign_id\": \"\",\n    \"value\": {\n      \"denomination\": {{first(2.`Award Amount`)}},\n      \"currency_code\": \"USD\"\n    },\n    \"delivery\": {\n      \"method\": \"EMAIL\",\n      \"meta\": {\n        \"from_name\": \"127 Sports Intensity\",\n        \"subject_line\": \"127 Sports Intensity Award\",\n        \"message\": \"You earned a 127 Sports Intensity Shooting Challenge award. This email contains your digital reward.\"\n      }\n    },\n    \"recipient\": {\n      \"name\": \"{{2.`Recipient Name`}}\",\n      \"email\": \"{{2.`Recipient Email`}}\"\n    }\n  }\n}",
        "parseResponse": true,
        "authPass": "",
        "authUser": "",
        "timeout": "30",
        "shareCookies": false,
        "rejectUnauthorized": true,
        "followRedirect": true,
        "useQuerystring": false,
        "gzip": true
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 150,
          "name": "POST Tremendous Sandbox Order"
