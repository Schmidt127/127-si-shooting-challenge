    {
      "id": 7,
      "module": "airtable:ActionUpdateRecords",
      "version": 3,
      "parameters": {
        "__IMTCONN__": 4739462
      },
      "filter": {
        "name": "Approved sandbox awards only",
        "conditions": [
          [
            {
              "a": "{{2.`Gift Card Needed?`}}",
              "o": "text:equal",
              "b": "1"
            },
            {
              "a": "{{2.`Send to Tremendous?`}}",
              "o": "boolean:equal",
              "b": "true"
            },
            {
              "a": "{{2.`Award Status`}}",
              "o": "text:equal",
              "b": "Approved"
            },
            {
              "a": "{{2.`Recipient Email`}}",
              "o": "exist"
            },
            {
              "a": "{{2.`Award Amount`}}",
              "o": "number:greater",
              "b": "0"
            },
            {
              "a": "{{2.`Tremendous Order ID`}}",
              "o": "text:equal",
              "b": "{{emptystring}}"
            },
            {
              "a": "{{2.`Tremendous Reward ID`}}",
              "o": "text:equal",
              "b": "{{emptystring}}"
            },
            {
              "a": "{{2.`Tremendous Environment`}}",
              "o": "text:equal",
              "b": "Sandbox"
            }
          ]
        ]
      },
